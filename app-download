<script>
(function () {
  var phone = document.querySelector(".phone");
  var contour = document.querySelector(".contour-bg");
  var hero = document.querySelector(".hero");
  if (phone) {
    requestAnimationFrame(function () {
      phone.style.transition = "transform 1s cubic-bezier(.2,.8,.2,1)";
      phone.style.transform = "rotate(-2deg) translateY(0)";
    });
  }
  if (hero && contour && window.matchMedia("(min-width:960px)").matches && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    hero.addEventListener("mousemove", function (e) {
      var x = (e.clientX / window.innerWidth - 0.5) * 14;
      var y = (e.clientY / window.innerHeight - 0.5) * 14;
      contour.style.transform = "translate3d(" + x + "px," + y + "px,0)";
    });
  }
})();
</script>

